{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "coordinator",
  "model": "deepseek/deepseek-v4-flash",
  "compaction": {
    "auto": true,
    "prune": true
  },
  "permission": {
    "external_directory": {
      "*": "deny"
    },
    "read": {
      "*": "allow",
      ".env": "deny",
      "**/.env": "deny",
      ".env.*": "deny",
      "**/.env.*": "deny",
      ".env.example": "allow",
      "**/.env.example": "allow"
    },
    "bash": {
      "*": "allow",
      "git reset --hard*": "deny",
      "git clean*": "deny",
      "Remove-Item*": "ask",
      "rm *": "ask",
      "rmdir *": "ask",
      "del *": "ask",
      "*pip install*": "ask",
      "git commit*": "deny",
      "git push*": "deny",
      "git status*": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "git show*": "allow",
      "git ls-files*": "allow"
    }
  }
}

{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "coordinator",
  "model": "deepseek/deepseek-flash",
  "compaction": {
    "auto": true,
    "prune": true
  },
  "permission": {
    "read": {
      "*": "allow",
      ".env": "deny",
      "**/.env": "deny",
      ".env.*": "deny",
      "**/.env.*": "deny",
      ".env.example": "allow",
      "**/.env.example": "allow"
    },
    "edit": {
      "*": "allow",
      ".env": "deny",
      "**/.env": "deny",
      ".env.*": "deny",
      "**/.env.*": "deny",
      ".env.example": "allow",
      "**/.env.example": "allow",
      "AGENTS.md": "deny",
      "**/AGENTS.md": "deny",
      "STACK_PROFILES.md": "deny",
      "**/STACK_PROFILES.md": "deny",
      "PROJECT_RULES.md": "deny",
      "**/PROJECT_RULES.md": "deny",
      "opencode.json": "deny",
      "**/opencode.json": "deny",
      ".opencode/agents/*.md": "deny",
      "**/.opencode/agents/*.md": "deny",
      "week-03/memory-state-agent/run_app.bat": "deny",
      "**/week-03/memory-state-agent/run_app.bat": "deny",
      "week-03/memory-state-agent/test.bat": "deny",
      "**/week-03/memory-state-agent/test.bat": "deny",
      "week-03/memory-state-agent/smoke_test.bat": "deny",
      "**/week-03/memory-state-agent/smoke_test.bat": "deny"
    },
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "lsp": "allow",
    "skill": "allow",
    "todowrite": "allow",
    "task": "allow",
    "external_directory": {
      "*": "deny"
    },
    "bash": {
      "*": "ask",
      "run_app.bat*": "allow",
      ".\\run_app.bat*": "allow",
      ".\\week-03\\memory-state-agent\\test.bat": "allow",
      ".\\week-03\\memory-state-agent\\smoke_test.bat": "allow",
      "cmd /c run_app.bat*": "allow",
      "cmd.exe /c run_app.bat*": "allow",
      "Start-Process -FilePath \"cmd.exe\" -ArgumentList \"/c\",\"run_app.bat\"*": "allow",
      "Invoke-WebRequest*http://127.0.0.1:8501/_stcore/health*": "allow",
      "Invoke-WebRequest*http://127.0.0.1:8599/_stcore/health*": "allow",
      "Invoke-WebRequest*http://localhost:8501/_stcore/health*": "allow",
      "Invoke-WebRequest*http://localhost:8599/_stcore/health*": "allow",
      "Invoke-RestMethod*http://127.0.0.1:8501/_stcore/health*": "allow",
      "Invoke-RestMethod*http://127.0.0.1:8599/_stcore/health*": "allow",
      "Invoke-RestMethod*http://localhost:8501/_stcore/health*": "allow",
      "Invoke-RestMethod*http://localhost:8599/_stcore/health*": "allow",
      "Invoke-WebRequest -Uri \"http://127.0.0.1:8501/\"*": "allow",
      "Invoke-WebRequest -Uri \"http://127.0.0.1:8599/\"*": "allow",
      "Invoke-WebRequest -Uri \"http://localhost:8501/\"*": "allow",
      "Invoke-WebRequest -Uri \"http://localhost:8599/\"*": "allow",
      "Stop-Process*": "ask"
    }
  }
}

# Copy this file to .env and adjust the values if your local setup differs.
# The real .env is git-ignored and must never be committed.

# Local OpenAI-compatible model endpoint (loopback only).
AGENT_MODEL_BASE_URL=http://127.0.0.1:8080/v1
# Leave blank for the local run_app.bat fallback or the runtime default on other hosts.
# Set an explicit model name here to override either default.
AGENT_MODEL_NAME=
# Name of the environment variable that holds the model API key. The value
# itself lives in LOCAL_LLM_API_KEY and never appears in code or logs.
AGENT_MODEL_API_KEY_ENV=LOCAL_LLM_API_KEY
# Placeholder value for a local OpenAI-compatible server, which usually ignores
# the key. Set a real value here only if your server requires one; when the
# variable is missing the model is reported as not configured.
LOCAL_LLM_API_KEY=local-e2e
AGENT_MODEL_TIMEOUT_SECONDS=120

# MCP server (Streamable HTTP).
MCP_SERVER_URL=http://127.0.0.1:8765/mcp
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8765
MCP_CONNECT_TIMEOUT_SECONDS=10
MCP_CALL_TIMEOUT_SECONDS=30

# Backend (FastAPI + uvicorn).
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8600
PUBLIC_BACKEND_URL=http://127.0.0.1:8600
PUBLIC_FRONTEND_URL=http://127.0.0.1:8600

# Diagnostics.
AGENT_TRACE_PATH=logs/trace.jsonl
AGENT_LOG_LEVEL=INFO

# Persistence (chats, messages, scheduled tasks and runs). Both the backend and
# the MCP server read this one file; on a server set it outside the deploy
# directory (for example /var/lib/day16/day18.sqlite3). The default is
# <project>/data/day18.sqlite3, which is git-ignored.
AGENT_DB_PATH=

# How many of the most recent messages of the selected chat are sent to the
# model. The full history stays in the database and in the UI. Clamped to 2..100.
AGENT_CHAT_CONTEXT_MESSAGES=20

# How many tool-calling rounds one chat request may use. A multi-step
# composition (search -> digest -> save -> final answer) needs more than one
# round. Clamped to 2..10.
AGENT_MAX_TOOL_ROUNDS=5

# How often the MCP server's background scheduler looks for due tasks, in
# seconds. Clamped to 0.5..60. Tasks run in the MCP server process, so they do
# not need an open browser.
MCP_TASK_TICK_SECONDS=2

# Web search (Tavily Search API) used by the MCP server's `search_web` tool.
# The key is read only by the MCP server process and is never sent to the model,
# the UI, the trace or a log. Leave the key empty to keep the tool unconfigured:
# `search_web` then reports that search is not configured instead of inventing
# results. A missing .env is not an error.
MCP_SEARCH_API_KEY_ENV=TAVILY_API_KEY
TAVILY_API_KEY=
MCP_SEARCH_BASE_URL=https://api.tavily.com
# Timeout of one search request in seconds (clamped to 1..25).
MCP_SEARCH_TIMEOUT_SECONDS=10
# Default number of results, 1..10.
MCP_SEARCH_MAX_RESULTS=5
# Set to 0 to stop the MCP server from reading a local .env file at all.
MCP_LOAD_DOTENV=1

# Notifier MCP server (server B, day 20). The backend connects to it through the
# hub; an empty MCP_NOTIFIER_URL disables B without probing it. The notifier
# process itself binds MCP_NOTIFIER_HOST/MCP_NOTIFIER_PORT (default 127.0.0.1:8766).
MCP_NOTIFIER_URL=http://127.0.0.1:8766/mcp
MCP_NOTIFIER_HOST=127.0.0.1
MCP_NOTIFIER_PORT=8766
# Separate SQLite file owned only by server B (default data/day20-notifier.sqlite3).
NOTIFIER_DB_PATH=

# Telegram delivery. Both values are read ONLY by the notifier process (server B)
# and are never sent to the backend, the model, the UI or the trace. Leave them
# empty to keep delivery unconfigured (no network call, no invented success).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Base URL of the Telegram Bot API; tests point it at a loopback fake.
NOTIFIER_TELEGRAM_API_BASE_URL=https://api.telegram.org

# Host-side notification monitor (background, no browser). Enabled by default.
NOTIFIER_MONITOR_ENABLED=1
# Seconds between monitor ticks (clamped to 1..3600).
NOTIFIER_MONITOR_TICK_SECONDS=30
# Set to 0 to stop the notifier process from reading a local .env file at all;
# harnesses and tests set it to 0 to stay isolated from real secrets.
NOTIFIER_LOAD_DOTENV=1

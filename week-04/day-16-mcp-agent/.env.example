# Copy this file to .env and adjust the values if your local setup differs.
# The real .env is git-ignored and must never be committed.

# Local OpenAI-compatible model endpoint (loopback only).
AGENT_MODEL_BASE_URL=http://127.0.0.1:8080/v1
AGENT_MODEL_NAME=qwen3.8-27b-local
# Name of the environment variable that holds the model API key. The value
# itself lives in LOCAL_LLM_API_KEY and never appears in code or logs.
AGENT_MODEL_API_KEY_ENV=LOCAL_LLM_API_KEY
# Placeholder value for a local OpenAI-compatible server, which usually ignores
# the key. Set a real value here only if your server requires one; when the
# variable is missing the model is reported as not configured.
LOCAL_LLM_API_KEY=local-e2e
AGENT_MODEL_TIMEOUT_SECONDS=120

# MCP server (Streamable HTTP).
MCP_SERVER_URL=http://127.0.0.1:8765/mcp
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8765
MCP_CONNECT_TIMEOUT_SECONDS=10
MCP_CALL_TIMEOUT_SECONDS=30

# Backend (FastAPI + uvicorn).
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8600
PUBLIC_BACKEND_URL=http://127.0.0.1:8600
PUBLIC_FRONTEND_URL=http://127.0.0.1:8600

# Diagnostics.
AGENT_TRACE_PATH=logs/trace.jsonl
AGENT_LOG_LEVEL=INFO

# Web search (Tavily Search API) used by the MCP server's `search_web` tool.
# The key is read only by the MCP server process and is never sent to the model,
# the UI, the trace or a log. Leave the key empty to keep the tool unconfigured:
# `search_web` then reports that search is not configured instead of inventing
# results. A missing .env is not an error.
MCP_SEARCH_API_KEY_ENV=TAVILY_API_KEY
TAVILY_API_KEY=
MCP_SEARCH_BASE_URL=https://api.tavily.com
# Timeout of one search request in seconds (clamped to 1..25).
MCP_SEARCH_TIMEOUT_SECONDS=10
# Default number of results, 1..10.
MCP_SEARCH_MAX_RESULTS=5
# Set to 0 to stop the MCP server from reading a local .env file at all.
MCP_LOAD_DOTENV=1

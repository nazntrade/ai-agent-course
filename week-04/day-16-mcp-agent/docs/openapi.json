        "summary": "Rename Chat",
        "operationId": "rename_chat_api_chats__chat_id__patch",
        "parameters": [
          {
            "name": "chat_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Chat Id"

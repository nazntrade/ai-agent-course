  "components": {
    "schemas": {
      "ChatClearResponse": {
        "properties": {
          "cleared": {
            "type": "boolean",
            "title": "Cleared"
          },
          "messages_deleted": {
            "type": "integer",
            "title": "Messages Deleted",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "cleared"
        ],
        "title": "ChatClearResponse",
        "description": "Result of clearing one chat."
      },
      "ChatCreateRequest": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title",
            "default": ""
          }
        },
        "type": "object",
        "title": "ChatCreateRequest",
        "description": "Payload of ``POST /api/chats``; an empty title gets the default."
      },
      "ChatDeleteResponse": {
        "properties": {
          "deleted": {
            "type": "boolean",
            "title": "Deleted"
          },
          "stopped_tasks": {
            "type": "integer",
            "title": "Stopped Tasks",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "deleted"
        ],
        "title": "ChatDeleteResponse",
        "description": "Result of deleting a chat."
      },
      "ChatInfo": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "created_at": {
            "type": "number",
            "title": "Created At"
          },
          "updated_at": {
            "type": "number",
            "title": "Updated At"
          },
          "message_count": {
            "type": "integer",
            "title": "Message Count",
            "default": 0
          },
          "active_tasks_count": {
            "type": "integer",
            "title": "Active Tasks Count",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "created_at",
          "updated_at"
        ],
        "title": "ChatInfo",
        "description": "One chat as shown in the chat list."
      },
      "ChatListResponse": {
        "properties": {
          "chats": {
            "items": {
              "$ref": "#/components/schemas/ChatInfo"
            },
            "type": "array",
            "title": "Chats"
          },
          "count": {
            "type": "integer",
            "title": "Count",
            "default": 0
          },
          "limit": {
            "type": "integer",
            "title": "Limit",
            "default": 5
          },
          "limit_reached": {
            "type": "boolean",
            "title": "Limit Reached",
            "default": false
          }
        },
        "type": "object",
        "title": "ChatListResponse",
        "description": "The chat list plus the configured limit."
      },
      "ChatMessagesResponse": {
        "properties": {
          "chat_id": {
            "type": "string",
            "title": "Chat Id"
          },
          "messages": {
            "items": {
              "$ref": "#/components/schemas/MessageInfo"
            },
            "type": "array",
            "title": "Messages"
          },
          "count": {
            "type": "integer",
            "title": "Count",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "chat_id"
        ],
        "title": "ChatMessagesResponse",
        "description": "The full stored history of one chat."
      },
      "ChatRenameRequest": {
        "properties": {
          "title": {
            "type": "string",
            "title": "Title"
          }
        },
        "type": "object",
        "required": [
          "title"
        ],
        "title": "ChatRenameRequest",
        "description": "Payload of ``PATCH /api/chats/{chat_id}``."
      },
      "ChatReportsResponse": {
        "properties": {
          "chat_id": {
            "type": "string",
            "title": "Chat Id"
          },
          "reports": {
            "items": {
              "$ref": "#/components/schemas/ReportInfo"
            },
            "type": "array",
            "title": "Reports"
          },
          "count": {
            "type": "integer",
            "title": "Count",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "chat_id"
        ],
        "title": "ChatReportsResponse",
        "description": "The saved reports of one chat, newest first."
      },
      "ChatRequest": {
        "properties": {
          "chat_id": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Chat Id"
          },
          "message": {
            "type": "string",
            "maxLength": 8000,
            "minLength": 1,
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "chat_id",
          "message"
        ],
        "title": "ChatRequest",
        "description": "One chat turn of one saved chat."
      },
      "ChatTasksResponse": {
        "properties": {
          "chat_id": {
            "type": "string",
            "title": "Chat Id"
          },
          "tasks": {
            "items": {
              "$ref": "#/components/schemas/TaskInfo"
            },
            "type": "array",
            "title": "Tasks"
          },
          "count": {
            "type": "integer",
            "title": "Count",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "chat_id"
        ],
        "title": "ChatTasksResponse",
        "description": "The scheduled tasks of one chat."
      },
      "ErrorInfo": {
        "properties": {
          "category": {
            "type": "string",
            "title": "Category"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "type": "object",
        "required": [
          "category",
          "message"
        ],
        "title": "ErrorInfo",
        "description": "Controlled failure of a dependency."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "title": "Status"
          },
          "service": {
            "type": "string",
            "title": "Service"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "service",
          "version"
        ],
        "title": "HealthResponse",
        "description": "Liveness of the backend process."
      },
      "McpStatusResponse": {
        "properties": {
          "connected": {
            "type": "boolean",
            "title": "Connected"
          },
          "protocol_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Protocol Version"
          },
          "server": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ServerInfo"
              },
              {
                "type": "null"
              }
            ]
          },
          "tools_count": {
            "type": "integer",
            "title": "Tools Count",
            "default": 0
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorInfo"
              },
              {
                "type": "null"
              }
            ]
          },
          "checked_at": {
            "type": "number",
            "title": "Checked At"
          }
        },
        "type": "object",
        "required": [
          "connected",
          "checked_at"
        ],
        "title": "McpStatusResponse",
        "description": "Current MCP connectivity and tool count."
      },
      "McpToolsResponse": {
        "properties": {
          "connected": {
            "type": "boolean",
            "title": "Connected"
          },
          "tools": {
            "items": {
              "$ref": "#/components/schemas/ToolInfo"
            },
            "type": "array",
            "title": "Tools"
          },
          "count": {
            "type": "integer",
            "title": "Count",
            "default": 0
          },
          "protocol_version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Protocol Version"
          },
          "server": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ServerInfo"
              },
              {
                "type": "null"
              }
            ]
          },
          "error": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/ErrorInfo"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "connected"
        ],
        "title": "McpToolsResponse",
        "description": "The full MCP tool list; ``connected`` is false when MCP is down."
      },
      "MessageInfo": {
        "properties": {
          "role": {
            "type": "string",
            "title": "Role"
          },
          "content": {
            "type": "string",
            "title": "Content"
          },
          "created_at": {
            "type": "number",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "role",
          "content",
          "created_at"
        ],
        "title": "MessageInfo",
        "description": "One stored chat message."
      },
      "ReportDetail": {
        "properties": {
          "report_id": {
            "type": "string",
            "title": "Report Id"
          },
          "chat_id": {
            "type": "string",
            "title": "Chat Id"
          },
          "topic": {
            "type": "string",
            "title": "Topic"
          },
          "summary": {
            "type": "string",
            "title": "Summary"
          },
          "created_at": {
            "type": "number",
            "title": "Created At"
          },
          "source_count": {
            "type": "integer",
            "title": "Source Count",
            "default": 0
          },
          "sources": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Sources"
          }
        },
        "type": "object",
        "required": [
          "report_id",
          "chat_id",
          "topic",
          "summary",
          "created_at"
        ],
        "title": "ReportDetail",
        "description": "One saved report with its plain-text summary and sources."
      },
      "ReportInfo": {
        "properties": {
          "report_id": {
            "type": "string",
            "title": "Report Id"
          },
          "topic": {
            "type": "string",
            "title": "Topic"
          },
          "created_at": {
            "type": "number",
            "title": "Created At"
          },
          "source_count": {
            "type": "integer",
            "title": "Source Count",
            "default": 0
          }
        },
        "type": "object",
        "required": [
          "report_id",
          "topic",
          "created_at"
        ],
        "title": "ReportInfo",
        "description": "One saved report as shown in the Saved reports panel."
      },
      "ServerInfo": {
        "properties": {
          "name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Name"
          },
          "version": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Version"
          }
        },
        "type": "object",
        "title": "ServerInfo",
        "description": "Identity of the connected MCP server."
      },
      "TaskInfo": {
        "properties": {
          "task_id": {
            "type": "string",
            "title": "Task Id"
          },
          "query": {
            "type": "string",
            "title": "Query"
          },
          "interval_seconds": {
            "type": "integer",
            "title": "Interval Seconds"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "created_at": {
            "type": "number",
            "title": "Created At"
          },
          "next_run_at": {
            "type": "number",
            "title": "Next Run At"
          },
          "last_run_at": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Run At"
          },
          "last_status": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Status"
          },
          "last_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Error"
          },
          "run_count": {
            "type": "integer",
            "title": "Run Count",
            "default": 0
          },
          "last_run": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/TaskRunInfo"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "task_id",
          "query",
          "interval_seconds",
          "status",
          "created_at",
          "next_run_at"

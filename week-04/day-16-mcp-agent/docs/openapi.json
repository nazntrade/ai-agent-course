{
  "openapi": "3.1.0",
  "info": {
    "title": "Day 16 MCP Agent",
    "description": "Local agent with a real MCP server (Streamable HTTP), a discovery CLI and a streamed browser chat.",
    "version": "1.0.0"
  },

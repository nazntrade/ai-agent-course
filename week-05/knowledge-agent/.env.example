# Copy this file to .env and adjust if needed. Never commit .env.
# Values below are safe defaults, not secrets.

# HTTP service (loopback only).
KNOWLEDGE_HOST=127.0.0.1
KNOWLEDGE_PORT=8770
KNOWLEDGE_DB_PATH=local-data/index.db
# The source path is empty by default: the user passes explicit paths
# through POST /api/index/build; the app never scans the disk.
KNOWLEDGE_SOURCE_PATH=
KNOWLEDGE_UI_TITLE=Knowledge Agent

# Local Ollama embedding provider.
EMBED_BASE_URL=http://127.0.0.1:11434
EMBED_MODEL=embeddinggemma:300m
EMBED_BATCH_SIZE=16
EMBED_TIMEOUT_SECONDS=60
# Applied only by OllamaEmbedder; leave empty unless the model needs task prefixes.
EMBED_DOCUMENT_PREFIX=
EMBED_QUERY_PREFIX=

# Day 22 chat generation (RAG). CHAT_MODEL is empty on purpose: the app never
# guesses a model and never downloads one. Set it to an installed Ollama model.
CHAT_BASE_URL=http://127.0.0.1:11434
CHAT_MODEL=
CHAT_TIMEOUT_SECONDS=120
CHAT_MAX_OUTPUT_TOKENS=1024
CHAT_CONTEXT_TOKENS=8192
CHAT_TEMPERATURE=0
CHAT_SEED=0
CHAT_TOP_K=5
CHAT_CONTEXT_CHARS_PER_TOKEN=3
CHAT_RUNS_PATH=local-data/chat-runs

# Day 23 retrieval filter and query rewrite (SPEC D23 10).
# Safe defaults below keep the D22 behaviour; uncomment only to change it.
# These are the exact config.py keys (RAG_FILTER_TOP_K is the postfilter top-K).
# RAG_FILTER_ENABLED=0
# RAG_REWRITE_ENABLED=0
# RAG_MIN_SCORE=0.0
# RAG_PREFILTER_TOP_K=20
# RAG_FILTER_TOP_K=5
# RAG_REWRITE_TIMEOUT_SECONDS=30
# RAG_REWRITE_MAX_OUTPUT_TOKENS=1024
# RAG_REWRITE_TEMPERATURE=0
# D23_DATA_PATH=local-data/d23
# D23_CALIBRATION_QUESTIONS_PATH=eval/d23/calibration-questions.json

# Day 24 grounded RAG (SPEC D24 10).
# RAG_GROUNDING_ENABLED=1 exposes sources and verified citations in RAG answers
# (/api/chat, /api/chat/stream, /api/chat/compare-modes); /api/chat/compare is
# never grounded. Set to 0 to restore the D22 free-text rag-v1 path.
# RAG_GROUNDING_ENABLED=1
# D24_DATA_PATH=local-data/d24
# D24_QUESTIONS_PATH=eval/d22/questions.json

# Day 25 mini-chat (SPEC D25 16). The conversation store is a SEPARATE SQLite
# file: dialogue history and task memory live here, the D21 document index
# stays in KNOWLEDGE_DB_PATH, and legacy chat-run-v1 records are never imported.
# DIALOGUE_DB_PATH=local-data/conversations.db
# D25_DATA_PATH=local-data/d25
# D25_HISTORY_MAX_TURNS=6
# D25_HISTORY_MAX_TOKENS=1200

# Chunking.
CHUNK_SIZE=500
CHUNK_OVERLAP=75
CHUNK_STRUCTURE_MAX_TOKENS=800
CHUNK_STRUCTURE_MIN_TOKENS=64
CHUNK_STRUCTURE_MAX_CHARS=3200

# A page counts as useful when it yields at least this many characters.
PDF_USEFUL_PAGE_MIN_CHARS=500

# Separate D25 dialogue allowance: reasoning and visible output share provider max_tokens.
# Automatic defaults: selected network 32768/8192, selected local at least 16384/3072,
# legacy/stub keeps configured CHAT_* values. Automatic reserves fit the advertised
# server window (at most one quarter); explicit oversized reserves fail visibly.
# Zero means automatic; explicit positive values override only D25, not D22-D24.
D25_CHAT_CONTEXT_TOKENS=0
D25_CHAT_MAX_OUTPUT_TOKENS=0
